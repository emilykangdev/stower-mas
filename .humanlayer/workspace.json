{
  "disabled": false,
  "pathTemplate": "~/worktrees/{{ REPOBASENAME }}/{{ TASKSLUG }}",
  "branchTemplate": "{{ TASKSLUG }}",
  "sourceRef": "HEAD",
  "setupCommand": "./Scripts/new-worktree.sh",
  "copyGlobs": [
    ".env",
    ".env.local",
    ".env.development.local",
    ".env.keys",
    ".claude/settings.local.json",
    ".humanlayer/workspace.local.json"
  ],
  "repos": [
    {
      "localPath": ".",
      "description": "Stower (Mac App Store build) — Swift monorepo",
      "primary": true
    }
  ]
}
